[Unit]
Description=Signature Wall (山水留痕 · 电子签名墙)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sign
Environment=NODE_ENV=production
Environment=PORT=8080
ExecStart=/usr/bin/node /opt/sign/server/index.js
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

# 数据目录在 /opt/sign/data，按需调整权限
# User=www-data
# Group=www-data

[Install]
WantedBy=multi-user.target
